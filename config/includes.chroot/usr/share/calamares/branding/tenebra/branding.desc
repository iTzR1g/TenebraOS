# TenebraOS Calamares branding (Calamares 3.3.x)
---
componentName:  tenebra

### WELCOME / OVERALL WORDING
welcomeStyleCalamares:   false
welcomeExpandingLogo:    true

### WINDOW CONFIGURATION
windowExpanding:    normal
windowSize: 900px,600px
windowPlacement: center

### PANELS CONFIGURATION
sidebar: widget
navigation: widget

### STRINGS
strings:
    productName:         TenebraOS
    shortProductName:    Tenebra
    version:             1.0
    shortVersion:        1.0
    versionedName:       TenebraOS 1.0
    shortVersionedName:  Tenebra 1.0
    bootloaderEntryName: TenebraOS

### IMAGES
images:
    productIcon:         "logo.png"
    productLogo:         "logo.png"
    productWallpaper:    "background.png"
    productWelcome:      "background.png"

### COLORS (monochrome)
style:
    SidebarBackground:        "#000000"
    SidebarText:              "#FFFFFF"
    SidebarTextCurrent:       "#000000"
    SidebarBackgroundCurrent: "#FFFFFF"

### SLIDESHOW
slideshow:               "show.qml"
slideshowAPI:            2
