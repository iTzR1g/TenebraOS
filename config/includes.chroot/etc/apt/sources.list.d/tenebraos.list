# Index (dists/) is served from this git repo via raw.githubusercontent;
# the binary pool (.deb assets) is hosted on the tenebraos-repo-pool
# GitHub release — Packages' Filename fields point there directly.
deb [signed-by=/usr/share/keyrings/tenebraos-repo.gpg] https://raw.githubusercontent.com/iTzR1g/TenebraOS/main/repo tenebraos main
