componentName: tenebra
componentVersion: "1.0"
name: Tenebra
description:
    en: Tenebra Installer
version: "1.0"
author:
    name: Tenebra Team

# Required by Calamares 3.3 (bails out at startup when missing)
strings:
    productName:         TenebraOS
    shortProductName:    TenebraOS
    version:             1.0
    shortVersion:        1.0
    versionedName:       TenebraOS 1.0
    shortVersionedName:  TenebraOS 1.0
