images:
    productLogo:         logo.png
    productIcon:         logo.png
    productWallpaper:    background.png
    productWelcome:      background.png

welcomeStyle: true
welcomeExpanding: true
showProgressBar: true
showMenu: false
slideshow: "show.qml"
