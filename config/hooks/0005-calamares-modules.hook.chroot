#!/bin/bash
# Staged modules (config/includes.chroot/calamares/modules) land at
# /calamares/modules; move them where Calamares searches. profileselect
# is NOT here anymore: it is the stock packagechooser module under a
# custom instance, configured from /etc/calamares/modules/profileselect.conf.
MODULES_SRC="/calamares/modules"
MODULES_DST="/usr/share/calamares/modules"
if [ -d "$MODULES_SRC" ]; then
    for mod in hardwaredetect autoconfig; do
        rm -rf "$MODULES_DST/$mod"
        if [ -d "$MODULES_SRC/$mod" ]; then
            cp -r "$MODULES_SRC/$mod" "$MODULES_DST/"
        fi
    done
fi
