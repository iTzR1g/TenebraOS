#!/bin/bash
rm -rf /usr/share/plymouth/themes/debian-logo
rm -rf /usr/share/plymouth/themes/debian
rm -f /etc/plymouth/plymouthd.conf
mkdir -p /usr/share/plymouth/themes/tenebraos
cat > /usr/share/plymouth/themes/tenebraos/tenebraos.plymouth << 'EOF'
[Plymouth Theme]
Name=TenebraOS
Description=TenebraOS Dark Boot Splash
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/tenebraos
ScriptFile=/usr/share/plymouth/themes/tenebraos/tenebraos.script
EOF
cat > /usr/share/plymouth/themes/tenebraos/tenebraos.script << 'SCRIPT'
wallpaper = Image("dark-bg.png");
sprite = Sprite();
sprite.SetImage(wallpaper);
sprite.SetPosition(0, 0, 0);
fun message_callback(text) {
}
SCRIPT
plymouth-set-default-theme tenebraos 2>/dev/null || true
