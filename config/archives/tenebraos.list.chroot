# TenebraOS package repository (chroot during build)
# trusted=yes: the keyring ships via includes.chroot, but live-build may run
# the first apt update before includes are unpacked — don't fail on that.
deb [trusted=yes signed-by=/usr/share/keyrings/tenebraos-repo.gpg] https://github.com/iTzR1g/TenebraOS/releases/download/tenebraos-repo-pool/ tenebraos main
