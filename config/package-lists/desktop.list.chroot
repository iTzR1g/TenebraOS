flatpak
distrobox
podman

calamares

# Calamares settings ship in our own tenebra-calamares package
# (config/packages/tenebra-calamares) — no calamares-settings-devuan here.

live-boot
live-config
live-config-runit
# runit-init and its service supervision come in through live-config-runit,
# which provides live-config-backend and Depends on runit-init. Installing
# runit-init removes sysvinit-core, and since live-config-sysvinit hard-
# depends on that, using it here would leave live-config without a backend.
runit
elogind
dbus

udisks2
sudo
network-manager

curl
dosfstools
e2fsprogs
ntfs-3g

