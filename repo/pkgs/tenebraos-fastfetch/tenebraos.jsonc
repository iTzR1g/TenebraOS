{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/fastfetch/presets/tenebra-logo.txt",
    "color": {
      "1": "white"
    }
  },
  "display": {
    "separator": " ── ",
    "key": {
      "color": "gray"
    },
    "value": {
      "color": "white"
    }
  },
  "modules": [
    { "type": "title", "format": "{name}-{version}" },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "cpu",
    "gpu",
    "memory"
  ]
}