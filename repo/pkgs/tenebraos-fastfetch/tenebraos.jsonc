{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/fastfetch/presets/tenebra-logo.txt",
    "color": {
      "1": "white"
    }
  },
  "display": {
    "separator": " \u2192 ",
    "key": {
      "color": "gray"
    },
    "color": "white"
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "separator",
      "format": "{separator}"
    },
    "os",
    {
      "type": "host"
    },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "font",
    "cpu",
    "gpu",
    "memory",
    "disk"
  ]
}
