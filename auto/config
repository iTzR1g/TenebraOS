#!/bin/sh

# Speed: route package downloads through apt-cacher-ng when it is running
# (sudo apt install apt-cacher-ng) — huge win for repeated builds.
PROXY_OPTS=""
if command -v curl >/dev/null 2>&1 && \
   curl -fsI --max-time 1 http://127.0.0.1:3142/ >/dev/null 2>&1; then
    PROXY_OPTS="--apt-http-proxy http://127.0.0.1:3142 --apt-https-proxy http://127.0.0.1:3142"
fi

lb config noauto \
  --distribution excalibur \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --binary-images iso-hybrid \
  --debian-installer false \
  --initsystem sysvinit \
  --keyring-packages devuan-keyring \
  --mirror-bootstrap http://deb.devuan.org/merged \
  --mirror-chroot http://deb.devuan.org/merged \
  --mirror-binary http://deb.devuan.org/merged \
  --security false \
  --updates false \
  --apt-options "--yes -o Acquire::ForceIPv4=true -o Acquire::Retries=5" \
  --bootappend-live "boot=live components nomodeset quiet splash username=user hostname=tenebra" \
  --iso-application "TenebraOS" \
  --iso-publisher "TenebraOS" \
  --iso-volume "TenebraOS" \
  --linux-flavours amd64 \
  --mode debian \
  --apt-recommends true \
  ${PROXY_OPTS} \
  "${@}"